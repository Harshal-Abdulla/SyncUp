# Copy to backend/.env and fill in real values. Never commit the filled-in file.
#
# MONGO_URI comes from Atlas: Database > Connect > Drivers. Create a database
# user scoped to this one database with readWrite, not an admin user.
NODE_ENV=development
PORT=5000
MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/task-collaboration-tool
# Any long random string. Generate one with:  openssl rand -base64 48
JWT_SECRET=
FRONTEND_URL=http://localhost:3000
